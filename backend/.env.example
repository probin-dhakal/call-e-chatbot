# PostgreSQL connection string used by SQLAlchemy
DATABASE_URL=postgresql://localhost/call_e

# Supabase Storage credentials for uploaded organization PDFs — separate
# from DATABASE_URL. Find both under Project Settings -> API in the
# Supabase dashboard. Use the service_role secret key (not the anon key) so
# the backend can read/write the private "documents" bucket server-side.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_service_role_or_sb_secret_key
SUPABASE_STORAGE_BUCKET=documents

# Secret used to sign JWTs — set a long random value in real deployments
JWT_SECRET_KEY=change-me-to-a-long-random-value

# Comma-separated list of frontend origins allowed to call the API
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174

# Google Gemini API key — powers the conversation LLM (knowledge-assistant
# chat). Get one at https://aistudio.google.com/apikey
#
# Optional GEMINI_API_KEY_2 / _3 / ... (up to _10) can be set to rotate to
# the next key when one hits Gemini's free-tier per-key daily quota (429).
#
# gemini-3.5-flash-lite responds in ~1-2s; gemini-3.6-flash is a "thinking"
# model and takes ~15-20s per reply for noticeably better reasoning — swap
# this if you need the extra quality and can tolerate the latency.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_KEY_2=your_second_gemini_api_key
GEMINI_MODEL=gemini-3.5-flash-lite

# Groq is not used by the active chat pipeline anymore — kept only in case
# other dormant code depends on it. Safe to leave unset.
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=allam-2-7b

# RAG tuning — see backend/config.py for how the default threshold was measured
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
CHUNK_SIZE=500
CHUNK_OVERLAP=50
RAG_TOP_K=4
RAG_RELEVANCE_THRESHOLD=0.48
MAX_HISTORY_MESSAGES=12

# Upstash Redis — holds the active conversation session (agent/company
# snapshot + message history) for the lifetime of a chat, so /message
# doesn't hit Postgres on every turn. Find both under your database's
# REST API tab in the Upstash console. Postgres remains the permanent
# store — the session is persisted there and the Redis key cleared at /end.
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Conversations without a browser heartbeat are persisted as "abandoned".
CONVERSATION_INACTIVITY_TIMEOUT_SECONDS=900
CONVERSATION_CLEANUP_INTERVAL_SECONDS=60
